---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";
import { NAV_LINKS } from "@/data/navProjects";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    {/* ===== Launchpad 首屏：内容库入口矩阵 ===== */}
    <section id="launchpad" class="launchpad">
      <div class="launchpad-shell">
        <div class="launchpad-heading launchpad-panel">
          <span class="launchpad-eyebrow">AI LONGEVITY CONTENT HUB</span>
          <div class="launchpad-title-row">
            <h1 class="launchpad-name">AI 延续学内容库</h1>
            <a
              target="_blank"
              href="/rss.xml"
              class="launchpad-rss"
              aria-label="rss feed"
              title="RSS Feed"
            >
              <IconRss
                width={20}
                height={20}
                class="scale-125 stroke-accent stroke-3 rtl:-rotate-90"
              />
              <span class="sr-only">RSS Feed</span>
            </a>
          </div>
          <p class="launchpad-tagline">
            找开源工具，跑公开样本，读得懂失败原因
          </p>
          <p class="launchpad-sub">
            这里记录 AI
            衰老研究工具的真实试跑与中文教程。先用公开数据完成一次可核对的任务；找不到合适工具时，可以申请免费公开仓库初筛。
          </p>
          <div class="launchpad-chips">
            <span class="launchpad-chip">选工具 · 输入与许可</span>
            <span class="launchpad-chip">复现 · 公开样本</span>
            <span class="launchpad-chip">反馈 · 修复步骤</span>
          </div>
        </div>
        <div
          class="launchpad-grid launchpad-panel grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3"
        >
          {
            NAV_LINKS.map((link, index) => (
              <a
                href={link.url}
                class="project-card"
                style={`--delay: ${index * 90}ms`}
                target={link.url.startsWith("http") ? "_blank" : "_self"}
                rel={
                  link.url.startsWith("http")
                    ? "noopener noreferrer"
                    : undefined
                }
              >
                <div class="flex items-center gap-3">
                  <span class="project-icon">{link.icon}</span>
                  <span class="project-title">{link.title}</span>
                </div>
                <p class="project-desc">{link.desc}</p>
                <div class="project-footer">
                  <span class="project-tag">{link.tag}</span>
                  <span class="project-arrow">↗</span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {/* ===== 站点说明：移至下方，结构化呈现 ===== */}
    <section id="about" class="border-b border-border pt-10 pb-8">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <h2 class="text-2xl font-semibold tracking-wide">这个站点做什么</h2>
        <span class="text-base-content/50 text-xs tracking-[0.3em] uppercase">
          Operator Notes
        </span>
      </div>
      <div class="mt-6 grid gap-6 lg:grid-cols-[1.2fr_1fr]">
        <div class="text-base-content/80 space-y-3">
          <p class="text-lg text-foreground">
            这里给中文研究者与开发者提供可核查的开源工具入口和复现记录。
          </p>
          <p>
            每个已试跑项目都应能看到公开输入、固定源码、实际运行结果和失败处理。仅收录的项目会明确标注未试跑，不把模型输出当个人寿命或医疗结论。
          </p>
          <p>
            网站文章围绕“怎么用、怎么选、哪里会失败”来写，并链接到真实项目和公开纠错入口。访问量、使用需求和收费可行性都还要用真实数据检验。
          </p>
          {
            // only display if at least one social link is enabled
            SOCIALS.length > 0 && (
              <div class="mt-4 flex max-sm:flex-col sm:items-center">
                <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">找我聊聊</div>
                <Socials />
              </div>
            )
          }
        </div>
        <div class="about-panel">
          <div class="about-row">
            <span class="about-label">正在做</span>
            <span class="about-value">工具导航 / 公开样本试跑 / 实用文章</span>
          </div>
          <div class="about-row">
            <span class="about-label">航向</span>
            <span class="about-value">让更多人能核查并使用生命科学开源工具</span
            >
          </div>
          <div class="about-row">
            <span class="about-label">目标</span>
            <span class="about-value">先验证用户任务、真实反馈和网站访问</span>
          </div>
        </div>
      </div>
    </section>
    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-b border-border": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">⭐ 精选文章</h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">📝 最新文章</h2>
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        查看全部文章
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
