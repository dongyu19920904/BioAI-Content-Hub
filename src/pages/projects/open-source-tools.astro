---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import catalog from "@/data/openSourceCatalog.json";

const categories = [
  "全部",
  ...new Set(catalog.projects.map(project => project.category)),
];
const observedDate = catalog.observed_at.slice(0, 10);
---

<Layout
  title="AI 延寿研究开源工具导航｜按输入和试跑状态筛选"
  description="按研究输入、输出和许可证筛选生命科学开源工具，区分本站已用公开样本试跑与仅收录的项目。"
>
  <Header />
  <main id="main-content" class="app-layout mx-auto max-w-5xl px-4 py-10">
    <p class="text-sm font-semibold tracking-wide text-accent">
      可筛选的开源工具导航 · 当前 {catalog.projects.length} 项
    </p>
    <h1 class="mt-3 text-3xl font-bold sm:text-4xl">AI 延寿研究开源工具导航</h1>
    <p class="text-base-content/70 mt-5 leading-7">
      按研究输入和任务挑工具，直接进入原始仓库。这里只收录已查到仓库及许可证的研究软件；
      <strong>收录不表示本站完成复现、临床验证或需求验证</strong>。目前只有
      pyaging、scAgeClock、Biolearn、BioAge 和 methylclock
      的公开样本做过本站试跑。
    </p>
    <p class="text-base-content/60 mt-3 text-sm">
      GitHub 元数据核查日期：<time datetime={observedDate}>{observedDate}</time
      >。 定时刷新可能因 GitHub 接口不可用而延迟；请以原仓库为准。
    </p>
    <p class="mt-5">
      <a
        class="font-semibold text-accent underline"
        href="/services/repo-preflight/"
        >列表里没有你要试的公开项目？申请免费仓库初筛 →</a
      >
    </p>

    <section
      aria-label="筛选工具"
      class="bg-base-100 mt-8 rounded-xl border border-border p-5"
    >
      <label for="tool-search" class="block font-semibold"
        >搜项目、输入或用途</label
      >
      <input
        id="tool-search"
        type="search"
        placeholder="例如：单细胞、血液、pyaging"
        class="bg-base-100 mt-3 w-full rounded-lg border border-border px-4 py-3 text-base"
      />
      <div class="mt-5 flex flex-wrap gap-2" role="group" aria-label="研究类型">
        {
          categories.map((category, index) => (
            <button
              type="button"
              data-category-filter={category}
              aria-pressed={index === 0 ? "true" : "false"}
              class="rounded-full border border-border px-3 py-2 text-sm aria-pressed:border-accent aria-pressed:bg-accent/10 aria-pressed:text-accent"
            >
              {category}
            </button>
          ))
        }
      </div>
      <p
        id="tool-count"
        class="text-base-content/60 mt-4 text-sm"
        aria-live="polite"
      >
        显示 {catalog.projects.length} 个工具
      </p>
    </section>

    <section aria-label="开源工具结果" class="mt-6 grid gap-4 sm:grid-cols-2">
      {
        catalog.projects.map(project => (
          <article
            data-tool-card
            data-category={project.category}
            data-search={`${project.name} ${project.repo} ${project.category} ${project.input_zh} ${project.output_zh}`.toLocaleLowerCase()}
            class="bg-base-100 rounded-xl border border-border p-5"
          >
            <div class="flex flex-wrap items-center gap-2">
              <h2 class="text-xl font-semibold">{project.name}</h2>
              <span class="rounded-full bg-accent/10 px-2 py-1 text-xs text-accent">
                {project.category}
              </span>
              {project.github.archived && (
                <span class="rounded-full border border-amber-400 px-2 py-1 text-xs">
                  仓库已归档
                </span>
              )}
            </div>
            <dl class="mt-4 space-y-3 text-sm leading-6">
              <div>
                <>
                  <dt class="font-semibold">需要什么输入</dt>
                  <dd class="text-base-content/70">{project.input_zh}</dd>
                </>
              </div>
              <div>
                <>
                  <dt class="font-semibold">得到什么输出</dt>
                  <dd class="text-base-content/70">{project.output_zh}</dd>
                </>
              </div>
              <div>
                <>
                  <dt class="font-semibold">新手从哪里开始</dt>
                  <dd class="text-base-content/70">{project.start_zh}</dd>
                </>
              </div>
              <div>
                <>
                  <dt class="font-semibold">许可证 / 最近仓库推送</dt>
                  <dd class="text-base-content/70">
                    {project.github.license} ·{" "}
                    {project.github.pushed_at.slice(0, 10)}
                  </dd>
                </>
              </div>
            </dl>
            <p class="mt-4 rounded-lg border border-amber-400 bg-amber-50 p-3 text-sm text-amber-950 dark:bg-amber-950 dark:text-amber-100">
              {project.caution_zh}
            </p>
            <div class="mt-5 flex flex-wrap gap-4 text-sm font-semibold">
              <a
                class="text-accent underline"
                href={project.github.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                看原始仓库 ↗
              </a>
              {project.demo_url && (
                <a class="text-accent underline" href={project.demo_url}>
                  看本站已试跑示例 →
                </a>
              )}
            </div>
          </article>
        ))
      }
    </section>
    <p id="tool-empty" hidden class="mt-6 rounded-xl border border-border p-6">
      没找到匹配工具。试着清空搜索词或选“全部”。
    </p>

    <aside
      class="bg-base-100 mt-10 rounded-xl border border-border p-5 text-sm leading-7"
    >
      这里是帮助研究者找软件的导航，不接收个人化验单或健康资料，也不提供诊断、处方、寿命预测。
      仓库许可证只表示 GitHub 当前识别结果；商用、改造或再分发前要核对原始
      LICENSE 和依赖协议。 若链接、输入或许可证有误，可到
      <a
        class="text-accent underline"
        href="https://github.com/dongyu19920904/BioAI-Content-Hub/issues/new"
        target="_blank"
        rel="noopener noreferrer">公开仓库提出更正</a
      >。
    </aside>
  </main>
  <Footer />
</Layout>

<script>
  const search = document.querySelector<HTMLInputElement>("#tool-search");
  const filters = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-category-filter]"),
  ];
  const cards = [...document.querySelectorAll<HTMLElement>("[data-tool-card]")];
  const count = document.querySelector<HTMLElement>("#tool-count");
  const empty = document.querySelector<HTMLElement>("#tool-empty");
  let category = "全部";

  function update() {
    const query = search?.value.trim().toLocaleLowerCase() ?? "";
    let visible = 0;
    for (const card of cards) {
      const matches =
        (category === "全部" || card.dataset.category === category) &&
        (!query || card.dataset.search?.includes(query));
      card.hidden = !matches;
      if (matches) visible++;
    }
    if (count) count.textContent = `显示 ${visible} 个工具`;
    if (empty) empty.hidden = visible !== 0;
  }

  search?.addEventListener("input", update);
  for (const filter of filters) {
    filter.addEventListener("click", () => {
      category = filter.dataset.categoryFilter ?? "全部";
      for (const button of filters)
        button.setAttribute("aria-pressed", String(button === filter));
      update();
    });
  }
</script>
