---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { RESOURCE_PACKS } from "@/data/resourcePacks";
---

<Layout>
  <Header />
  <main id="main-content" class="app-layout">
    <section class="border-b border-border pt-8 pb-6">
      <p class="text-sm font-semibold tracking-[0.24em] text-accent uppercase">
        Resource Packs
      </p>
      <h1 class="mt-3 text-3xl font-bold sm:text-4xl">AI 延续学资料包</h1>
      <p class="text-base-content/70 mt-4 max-w-3xl">
        这是早期内容产品的历史构想，目前没有在本项目内出售或承诺交付。现阶段请从
        <a class="text-accent underline" href="/projects/open-source-tools/"
          >开源工具导航</a
        >
        和<a class="text-accent underline" href="/services/repo-preflight/"
          >免费公开仓库初筛</a
        >
        开始；下面的卡片只供了解旧想法，不代表已验证用户需求。
      </p>
    </section>

    <section class="grid gap-4 py-8 md:grid-cols-2">
      {
        RESOURCE_PACKS.map(pack => (
          <article class="bg-base-100 rounded-xl border border-border p-5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h2 class="text-xl font-semibold">{pack.title}</h2>
              <span class="rounded-full bg-accent/10 px-2 py-1 text-xs font-semibold text-accent">
                {pack.status}
              </span>
            </div>
            <p class="text-base-content/75 mt-3">{pack.desc}</p>
            <dl class="mt-4 grid gap-3 text-sm">
              <div>
                <dt class="text-base-content font-semibold">目标用户</dt>
                <dd class="text-base-content/70 mt-1">{pack.audience}</dd>
              </div>
              <div>
                <dt class="text-base-content font-semibold">交付物</dt>
                <dd class="mt-2 flex flex-wrap gap-2">
                  {pack.deliverables.map(item => (
                    <span class="text-base-content/70 rounded-md border border-border px-2 py-1">
                      {item}
                    </span>
                  ))}
                </dd>
              </div>
            </dl>
            <div class="mt-5 flex flex-wrap gap-3">
              {pack.relatedPost && (
                <a
                  class="text-sm font-semibold text-accent"
                  href={pack.relatedPost}
                >
                  查看相关文章
                </a>
              )}
            </div>
          </article>
        ))
      }
    </section>
  </main>
  <Footer />
</Layout>
