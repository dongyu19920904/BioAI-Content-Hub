---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { RESOURCE_PACKS } from "@/data/resourcePacks";
---

<Layout>
  <Header />
  <main id="main-content" class="app-layout">
    <section class="pt-8 pb-6 border-b border-border">
      <p class="text-sm font-semibold uppercase tracking-[0.24em] text-accent">
        Resource Packs
      </p>
      <h1 class="mt-3 text-3xl font-bold sm:text-4xl">AI 延续学资料包</h1>
      <p class="mt-4 max-w-3xl text-base-content/70">
        这里放的是可以从文章继续延伸出来的交付物：清单、模板、对比表、话术、工具导航和小产品说明书。先免费展示雏形，跑顺后再接 Aivora 小店发卡。
      </p>
    </section>

    <section class="grid gap-4 py-8 md:grid-cols-2">
      {
        RESOURCE_PACKS.map(pack => (
          <article class="rounded-xl border border-border bg-base-100 p-5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h2 class="text-xl font-semibold">{pack.title}</h2>
              <span class="rounded-full bg-accent/10 px-2 py-1 text-xs font-semibold text-accent">
                {pack.status}
              </span>
            </div>
            <p class="mt-3 text-base-content/75">{pack.desc}</p>
            <dl class="mt-4 grid gap-3 text-sm">
              <div>
                <dt class="font-semibold text-base-content">目标用户</dt>
                <dd class="mt-1 text-base-content/70">{pack.audience}</dd>
              </div>
              <div>
                <dt class="font-semibold text-base-content">交付物</dt>
                <dd class="mt-2 flex flex-wrap gap-2">
                  {pack.deliverables.map(item => (
                    <span class="rounded-md border border-border px-2 py-1 text-base-content/70">
                      {item}
                    </span>
                  ))}
                </dd>
              </div>
              <div>
                <dt class="font-semibold text-base-content">价格测试</dt>
                <dd class="mt-1 text-base-content/70">{pack.priceHint}</dd>
              </div>
            </dl>
            <div class="mt-5 flex flex-wrap gap-3">
              {
                pack.relatedPost && (
                  <a class="text-sm font-semibold text-accent" href={pack.relatedPost}>
                    查看相关文章
                  </a>
                )
              }
              <a class="text-sm font-semibold text-accent" href="https://aivora.cn" target="_blank" rel="noopener noreferrer">
                后续在 Aivora 承接
              </a>
            </div>
          </article>
        ))
      }
    </section>
  </main>
  <Footer />
</Layout>
